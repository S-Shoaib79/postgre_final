diff --git a/src/backend/commands/discreet_metadata.c b/src/backend/commands/discreet_metadata.c
new file mode 100644
index 00000000000..70e1f81fc38
--- /dev/null
+++ b/src/backend/commands/discreet_metadata.c
@@ -0,0 +1,388 @@
+/*-------------------------------------------------------------------------
+ *
+ * discreet_metadata.c
+ *	  Discreet metadata service: asset records for columns marked for
+ *	  encryption in their comment.
+ *
+ * A column is marked with its comment (pg_description):
+ *
+ *	COMMENT ON COLUMN employee.salary IS 'encrypt=yes; desc=Employee salary';
+ *
+ * encrypt takes yes/no (or true/false, on/off, 1/0); desc is optional and,
+ * when present, must come last (it runs to the end of the comment).
+ *
+ * CREATE TABLE (DefineRelation) and COMMENT ON (CommentObject) remember the
+ * table.  When the transaction commits, the service reads the comment of
+ * every column of those tables and writes one asset record per column with
+ * encrypt=yes to metadata.json in the data directory:
+ *
+ *	[
+ *	  {"assetName": "AST-5-16385-3", "assetDescription": "Employee salary",
+ *	   "columnId": 3, "tableId": 16385, "databaseId": 5, "columnName": ...}
+ *	]
+ *
+ * (each record is on one line in the file).  A table's old records are
+ * replaced, so a later COMMENT updates them; records of other tables and
+ * databases are kept.  DROP TABLE (heap_drop_with_catalog) remembers the
+ * table too: it no longer exists at commit, so its records are removed.  Writing at commit means a rolled-back CREATE TABLE
+ * writes nothing, and a table created and commented in one transaction is
+ * written once.
+ *
+ * src/backend/commands/discreet_metadata.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include <ctype.h>
+
+#include "access/transam.h"
+#include "access/xact.h"
+#include "catalog/pg_class.h"
+#include "commands/comment.h"
+#include "commands/dbcommands.h"
+#include "commands/discreet_metadata.h"
+#include "common/string.h"
+#include "lib/stringinfo.h"
+#include "miscadmin.h"
+#include "storage/fd.h"
+#include "storage/lock.h"
+#include "utils/builtins.h"
+#include "utils/json.h"
+#include "utils/lsyscache.h"
+#include "utils/memutils.h"
+#include "utils/rel.h"
+
+/* In the data directory, the backend's working directory */
+#define DISCREET_METADATA_FILE		"metadata.json"
+#define DISCREET_METADATA_TMPFILE	"metadata.json.tmp"
+
+/* Tables created or commented on in the current transaction */
+static List *pending_relids = NIL;
+static bool callback_registered = false;
+
+static void _PGS_Discreet_Metadata_XactCallback(XactEvent event, void *arg);
+
+/*
+ * Remember a table created or commented on; its records are written at
+ * commit.  Catalog tables and other relation kinds are filtered there.
+ */
+void
+_PGS_Discreet_Metadata_Track(Oid relid)
+{
+	MemoryContext oldcxt;
+
+	if (!OidIsValid(relid) || relid < FirstNormalObjectId)
+		return;
+
+	if (!callback_registered)
+	{
+		RegisterXactCallback(_PGS_Discreet_Metadata_XactCallback, NULL);
+		callback_registered = true;
+	}
+
+	oldcxt = MemoryContextSwitchTo(TopTransactionContext);
+	pending_relids = list_append_unique_oid(pending_relids, relid);
+	MemoryContextSwitchTo(oldcxt);
+}
+
+/* Strip leading and trailing white space in place */
+static char *
+_PGS_Discreet_Metadata_Trim(char *s)
+{
+	char	   *end;
+
+	while (isspace((unsigned char) *s))
+		s++;
+	end = s + strlen(s);
+	while (end > s && isspace((unsigned char) end[-1]))
+		end--;
+	*end = '\0';
+	return s;
+}
+
+/*
+ * Read a column comment "encrypt=yes; desc=<text>".  Keys are
+ * case-insensitive; desc (or description) is optional and runs to the end of
+ * the comment.  Returns true when encryption is allowed, with *desc set to
+ * the description or NULL.
+ */
+static bool
+_PGS_Discreet_Metadata_ParseComment(const char *comment, char **desc)
+{
+	char	   *p = pstrdup(comment);
+	bool		encrypt = false;
+
+	*desc = NULL;
+	while (p != NULL)
+	{
+		char	   *next = strchr(p, ';');
+		char	   *eq;
+		char	   *key;
+
+		if (next != NULL)
+			*next++ = '\0';
+
+		eq = strchr(p, '=');
+		if (eq != NULL)
+		{
+			*eq = '\0';
+			key = _PGS_Discreet_Metadata_Trim(p);
+
+			if (pg_strcasecmp(key, "desc") == 0 ||
+				pg_strcasecmp(key, "description") == 0)
+			{
+				char	   *val;
+
+				/* The description is the rest of the comment, ';' included */
+				if (next != NULL)
+					next[-1] = ';';
+				val = _PGS_Discreet_Metadata_Trim(eq + 1);
+				if (*val != '\0')
+					*desc = pstrdup(val);
+				break;
+			}
+
+			if (pg_strcasecmp(key, "encrypt") == 0)
+			{
+				bool		val;
+
+				if (parse_bool(_PGS_Discreet_Metadata_Trim(eq + 1), &val))
+					encrypt = val;
+			}
+		}
+		p = next;
+	}
+
+	return encrypt;
+}
+
+/*
+ * Unique asset name of a column: AST-<databaseId>-<tableId>-<columnId>.
+ * The three ids together are unique in the cluster.
+ */
+static char *
+_PGS_Discreet_Metadata_AssetName(Oid dbid, Oid relid, AttrNumber attnum)
+{
+	return psprintf("AST-%u-%u-%d", dbid, relid, attnum);
+}
+
+/* Append the asset records (JSON, one line each) of one table to *records */
+static void
+_PGS_Discreet_Metadata_CollectTable(Oid relid, List **records)
+{
+	char		relkind = get_rel_relkind(relid);
+	Relation	rel;
+	TupleDesc	tupdesc;
+	char	   *dbname;
+	char	   *tablename;
+
+	/* Dropped (DROP TABLE): no records, so Write() only removes the old ones */
+	if (relkind == '\0')
+	{
+		elog(LOG, "[DISCREET_METADATA] table %u of database %u dropped: its records are removed",
+			 relid, MyDatabaseId);
+		return;
+	}
+
+	/* Not a table (view, sequence, ...) */
+	if (relkind != RELKIND_RELATION && relkind != RELKIND_PARTITIONED_TABLE)
+		return;
+
+	rel = RelationIdGetRelation(relid);
+	if (!RelationIsValid(rel))
+		return;
+
+	tupdesc = RelationGetDescr(rel);
+	dbname = get_database_name(MyDatabaseId);
+	tablename = psprintf("%s.%s",
+						 get_namespace_name(RelationGetNamespace(rel)),
+						 RelationGetRelationName(rel));
+
+	for (int i = 0; i < tupdesc->natts; i++)
+	{
+		Form_pg_attribute att = TupleDescAttr(tupdesc, i);
+		char	   *comment;
+		char	   *desc;
+		char	   *asset;
+		StringInfoData buf;
+
+		if (att->attisdropped)
+			continue;
+
+		comment = GetComment(relid, RelationRelationId, att->attnum);
+		if (comment == NULL || !_PGS_Discreet_Metadata_ParseComment(comment, &desc))
+			continue;
+
+		/* No desc in the comment: identify the column by name */
+		if (desc == NULL)
+			desc = psprintf("%s.%s", tablename, NameStr(att->attname));
+
+		asset = _PGS_Discreet_Metadata_AssetName(MyDatabaseId, relid, att->attnum);
+
+		/* tableId and databaseId stay together: the file is filtered on them */
+		initStringInfo(&buf);
+		appendStringInfoString(&buf, "{\"assetName\": ");
+		escape_json(&buf, asset);
+		appendStringInfoString(&buf, ", \"assetDescription\": ");
+		escape_json(&buf, desc);
+		appendStringInfo(&buf, ", \"columnId\": %d, \"tableId\": %u, \"databaseId\": %u",
+						 att->attnum, relid, MyDatabaseId);
+		appendStringInfoString(&buf, ", \"columnName\": ");
+		escape_json(&buf, NameStr(att->attname));
+		appendStringInfoString(&buf, ", \"tableName\": ");
+		escape_json(&buf, tablename);
+		appendStringInfoString(&buf, ", \"databaseName\": ");
+		escape_json(&buf, dbname ? dbname : "");
+		appendStringInfoChar(&buf, '}');
+
+		*records = lappend(*records, buf.data);
+
+		elog(LOG, "[DISCREET_METADATA] asset %s | %s.%s (column %d, table %u, database %u) | %s",
+			 asset, tablename, NameStr(att->attname), att->attnum, relid,
+			 MyDatabaseId, desc);
+	}
+
+	RelationClose(rel);
+}
+
+/*
+ * Rewrite metadata.json: keep the records of tables not touched in this
+ * transaction, replace the records of the touched ones.
+ */
+static void
+_PGS_Discreet_Metadata_Write(void)
+{
+	List	   *records = NIL;
+	List	   *kept = NIL;
+	List	   *keys = NIL;
+	LOCKTAG		tag;
+	FILE	   *fp;
+	StringInfoData out;
+	ListCell   *lc;
+	bool		first = true;
+	int			nkept;
+	int			nremoved = 0;
+
+	foreach(lc, pending_relids)
+	{
+		Oid			relid = lfirst_oid(lc);
+
+		keys = lappend(keys, psprintf("\"tableId\": %u, \"databaseId\": %u,",
+									  relid, MyDatabaseId));
+		_PGS_Discreet_Metadata_CollectTable(relid, &records);
+	}
+
+	/*
+	 * One writer at a time, across all databases (database field 0): an
+	 * advisory lock held until this transaction ends.
+	 */
+	SET_LOCKTAG_ADVISORY(tag, InvalidOid, 0x44495343, 0x4D455441, 2);
+	(void) LockAcquire(&tag, ExclusiveLock, false, false);
+
+	/* Records are one per line, between "[" and "]" */
+	fp = AllocateFile(DISCREET_METADATA_FILE, "r");
+	if (fp != NULL)
+	{
+		StringInfoData line;
+
+		initStringInfo(&line);
+		while (pg_get_line_buf(fp, &line))
+		{
+			char	   *rec = _PGS_Discreet_Metadata_Trim(line.data);
+			size_t		len = strlen(rec);
+			bool		replaced = false;
+			ListCell   *lk;
+
+			if (rec[0] != '{')
+				continue;
+			if (rec[len - 1] == ',')
+				rec[len - 1] = '\0';
+
+			foreach(lk, keys)
+			{
+				if (strstr(rec, (char *) lfirst(lk)) != NULL)
+				{
+					replaced = true;
+					break;
+				}
+			}
+			if (replaced)
+				nremoved++;
+			else
+				kept = lappend(kept, pstrdup(rec));
+		}
+		FreeFile(fp);
+	}
+	else if (errno != ENOENT)
+	{
+		ereport(WARNING,
+				(errcode_for_file_access(),
+				 errmsg("[DISCREET_METADATA] could not read \"%s\": %m",
+						DISCREET_METADATA_FILE)));
+		return;
+	}
+
+	/* Counted before list_concat() appends the new records to kept */
+	nkept = list_length(kept);
+
+	initStringInfo(&out);
+	appendStringInfoString(&out, "[\n");
+	foreach(lc, list_concat(kept, records))
+	{
+		appendStringInfo(&out, "%s  %s", first ? "" : ",\n", (char *) lfirst(lc));
+		first = false;
+	}
+	appendStringInfoString(&out, first ? "]\n" : "\n]\n");
+
+	/* Write a temporary file and rename it, so readers never see half a file */
+	fp = AllocateFile(DISCREET_METADATA_TMPFILE, PG_BINARY_W);
+	if (fp == NULL ||
+		fwrite(out.data, 1, out.len, fp) != (size_t) out.len)
+	{
+		ereport(WARNING,
+				(errcode_for_file_access(),
+				 errmsg("[DISCREET_METADATA] could not write \"%s\": %m",
+						DISCREET_METADATA_TMPFILE)));
+		if (fp != NULL)
+			FreeFile(fp);
+		return;
+	}
+	if (FreeFile(fp) != 0)
+	{
+		ereport(WARNING,
+				(errcode_for_file_access(),
+				 errmsg("[DISCREET_METADATA] could not close \"%s\": %m",
+						DISCREET_METADATA_TMPFILE)));
+		return;
+	}
+	if (durable_rename(DISCREET_METADATA_TMPFILE, DISCREET_METADATA_FILE, WARNING) != 0)
+		return;
+
+	elog(LOG, "[DISCREET_METADATA] wrote %s | %d record(s) for %d table(s) of database %u, %d old record(s) removed, %d other record(s) kept",
+		 DISCREET_METADATA_FILE, list_length(records), list_length(pending_relids),
+		 MyDatabaseId, nremoved, nkept);
+}
+
+/* Write at commit; forget the tables when the transaction ends */
+static void
+_PGS_Discreet_Metadata_XactCallback(XactEvent event, void *arg)
+{
+	switch (event)
+	{
+		case XACT_EVENT_PRE_COMMIT:
+			if (pending_relids != NIL)
+				_PGS_Discreet_Metadata_Write();
+			break;
+		case XACT_EVENT_COMMIT:
+		case XACT_EVENT_ABORT:
+		case XACT_EVENT_PREPARE:
+		case XACT_EVENT_PARALLEL_COMMIT:
+		case XACT_EVENT_PARALLEL_ABORT:
+			/* The list itself goes with TopTransactionContext */
+			pending_relids = NIL;
+			break;
+		default:
+			break;
+	}
+}
diff --git a/src/backend/executor/am_client.cpp b/src/backend/executor/am_client.cpp
new file mode 100644
index 00000000000..5ec7b920941
--- /dev/null
+++ b/src/backend/executor/am_client.cpp
@@ -0,0 +1,549 @@
+/*-------------------------------------------------------------------------
+ *
+ * am_client.cpp
+ *	  Client of the Asset Access Service (AM), used by runtime_security.c.
+ *	  Everything that leaves PostgreSQL goes through here.
+ *
+ * Settings: am_client.conf in the data directory, read on every call, one
+ * "name = value" per line, # starts a comment:
+ *
+ *	url = http://127.0.0.1:8090           AM's address; empty = do not send
+ *	api_key = ak_...                      default X-Api-Key
+ *	api_key.<TenantID> = ak_...           X-Api-Key of one tenant
+ *	timeout_ms = 5000
+ *	path.tenants = /api/v1/tenants        POST a tenant
+ *	path.users = /api/v1/users            POST a user
+ *	path.roles = /api/v1/roles            POST the role-asset matrix
+ *	path.user_assets = /api/v1/users/{username}/assets   GET at login
+ *
+ * The real AM (asset-access-service.jar) takes the matrix and new tenants
+ * only from its platform admin, through its admin API.  Setting admin_user
+ * switches "roles" and "tenants" to that API: each call signs in for a
+ * token, sends it as "Authorization: Bearer", and signs out.  Users and
+ * logins keep using the tenant's API key.
+ *
+ *	admin_user = admin                    AM's platform admin
+ *	admin_password = ...
+ *	tenant_admin_user = manager           first admin of each new tenant
+ *	tenant_admin_password = ...           (AM refuses a tenant without one)
+ *	path.admin_token = /api/admin/auth/token
+ *	path.admin_logout = /api/admin/auth/logout
+ *	path.roles and path.tenants then default to /api/admin/role-asset-map
+ *	and /api/admin/tenants.
+ *	user_password = random                AM requires a password for every
+ *	                                      user; this sends a random one that
+ *	                                      nobody knows.  The flow never signs
+ *	                                      users in to AM: logins fetch their
+ *	                                      assets with the tenant's API key.
+ *
+ * Every call is appended to am_outbox.jsonl in the data directory, one JSON
+ * object per line: time, method, path, tenantId, status and the request
+ * body.  The API key, the admin and tenant admin passwords, the admin token
+ * and AM's answers (which carry the asset values) are never written.
+ *
+ * Only plain C crosses into PostgreSQL: no exception leaves this file and
+ * nothing here calls elog.  HTTP uses WinHTTP (part of Windows).
+ *
+ * src/backend/executor/am_client.cpp
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "executor/am_client.h"
+
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <fstream>
+#include <map>
+#include <random>
+#include <string>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <winhttp.h>
+#pragma comment(lib, "winhttp.lib")
+#endif
+
+namespace
+{
+
+const char *CONFIG_FILE = "am_client.conf";
+const char *OUTBOX_FILE = "am_outbox.jsonl";
+const size_t MAX_RESPONSE = 1024 * 1024;
+
+typedef std::map<std::string, std::string> Config;
+
+std::string
+_PGS_trim(const std::string &s)
+{
+	size_t		b = s.find_first_not_of(" \t\r\n");
+	size_t		e = s.find_last_not_of(" \t\r\n");
+
+	return b == std::string::npos ? std::string() : s.substr(b, e - b + 1);
+}
+
+Config
+_PGS_read_config()
+{
+	Config		cfg;
+	std::ifstream in(CONFIG_FILE);
+	std::string line;
+
+	while (std::getline(in, line))
+	{
+		size_t		hash = line.find('#');
+		size_t		eq;
+
+		if (hash != std::string::npos)
+			line.erase(hash);
+		eq = line.find('=');
+		if (eq != std::string::npos)
+			cfg[_PGS_trim(line.substr(0, eq))] = _PGS_trim(line.substr(eq + 1));
+	}
+	return cfg;
+}
+
+std::string
+_PGS_setting(const Config &cfg, const std::string &name, const std::string &dflt)
+{
+	Config::const_iterator it = cfg.find(name);
+
+	return it == cfg.end() || it->second.empty() ? dflt : it->second;
+}
+
+/* Percent-encode a path segment ("Asset 1" -> "Asset%201") */
+std::string
+_PGS_url_encode(const std::string &s)
+{
+	static const char hex[] = "0123456789ABCDEF";
+	std::string out;
+
+	for (unsigned char c : s)
+	{
+		if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~')
+			out += (char) c;
+		else
+		{
+			out += '%';
+			out += hex[c >> 4];
+			out += hex[c & 15];
+		}
+	}
+	return out;
+}
+
+std::string
+_PGS_json_string(const std::string &s)
+{
+	std::string out = "\"";
+
+	for (unsigned char c : s)
+	{
+		if (c == '"' || c == '\\')
+		{
+			out += '\\';
+			out += (char) c;
+		}
+		else if (c < 0x20)
+		{
+			char		buf[8];
+
+			snprintf(buf, sizeof(buf), "\\u%04x", c);
+			out += buf;
+		}
+		else
+			out += (char) c;
+	}
+	return out + "\"";
+}
+
+void
+_PGS_write_outbox(const std::string &method, const std::string &path,
+			 long long tenant_id, int status, const char *body)
+{
+	std::ofstream out(OUTBOX_FILE, std::ios::app | std::ios::binary);
+	char		when[32];
+	time_t		now = time(nullptr);
+	struct tm	tmv;
+
+#ifdef _WIN32
+	gmtime_s(&tmv, &now);
+#else
+	gmtime_r(&now, &tmv);
+#endif
+	strftime(when, sizeof(when), "%Y-%m-%dT%H:%M:%SZ", &tmv);
+
+	/* body is JSON built by PostgreSQL, so it is written as it is */
+	out << "{\"time\": \"" << when << "\", \"method\": \"" << method
+		<< "\", \"path\": " << _PGS_json_string(path)
+		<< ", \"tenantId\": " << tenant_id
+		<< ", \"status\": " << status
+		<< ", \"body\": " << (body ? body : "null") << "}\n";
+}
+
+#ifdef _WIN32
+std::wstring
+_PGS_widen(const std::string &s)
+{
+	int			n = MultiByteToWideChar(CP_UTF8, 0, s.c_str(), -1, nullptr, 0);
+	std::wstring w(n > 0 ? n : 1, L'\0');
+
+	if (n > 0)
+		MultiByteToWideChar(CP_UTF8, 0, s.c_str(), -1, &w[0], n);
+	w.resize(wcslen(w.c_str()));
+	return w;
+}
+
+struct Handle
+{
+	HINTERNET	h;
+	explicit Handle(HINTERNET x) : h(x) {}
+	~Handle() { if (h) WinHttpCloseHandle(h); }
+};
+
+/* The WinHTTP error, read before any handle is closed */
+int
+_PGS_winhttp_error(const std::string &method, const std::string &url, std::string &error)
+{
+	char		buf[64];
+
+	snprintf(buf, sizeof(buf), "WinHTTP error %lu", (unsigned long) GetLastError());
+	error = std::string(buf) + " calling " + method + " " + url;
+	return -1;
+}
+
+/* auth is one header line without its CRLF ("X-Api-Key: ..."), or empty */
+int
+_PGS_http(const std::string &method, const std::string &url,
+	 const std::string &auth, const char *body, int timeout_ms,
+	 std::string &response, std::string &error)
+{
+	std::wstring wurl = _PGS_widen(url);
+	URL_COMPONENTS uc;
+	wchar_t		host[256];
+	wchar_t		path[4096];
+	DWORD		status = 0;
+	DWORD		size = sizeof(status);
+	std::wstring headers = L"Accept: application/json\r\n";
+	DWORD		body_len = body ? (DWORD) strlen(body) : 0;
+
+	memset(&uc, 0, sizeof(uc));
+	uc.dwStructSize = sizeof(uc);
+	uc.lpszHostName = host;
+	uc.dwHostNameLength = 256;
+	uc.lpszUrlPath = path;
+	uc.dwUrlPathLength = 4096;
+	if (!WinHttpCrackUrl(wurl.c_str(), 0, 0, &uc))
+	{
+		error = "bad url in am_client.conf: " + url;
+		return -1;
+	}
+
+	Handle		session(WinHttpOpen(L"PostgreSQL-RuntimeSecurity/1.0",
+									WINHTTP_ACCESS_TYPE_DEFAULT_PROXY,
+									WINHTTP_NO_PROXY_NAME,
+									WINHTTP_NO_PROXY_BYPASS, 0));
+	if (!session.h)
+		return _PGS_winhttp_error(method, url, error);
+	WinHttpSetTimeouts(session.h, timeout_ms, timeout_ms, timeout_ms, timeout_ms);
+
+	Handle		connect(WinHttpConnect(session.h, host, uc.nPort, 0));
+	if (!connect.h)
+		return _PGS_winhttp_error(method, url, error);
+
+	Handle		request(WinHttpOpenRequest(connect.h, _PGS_widen(method).c_str(), path,
+										   nullptr, WINHTTP_NO_REFERER,
+										   WINHTTP_DEFAULT_ACCEPT_TYPES,
+										   uc.nScheme == INTERNET_SCHEME_HTTPS ?
+										   WINHTTP_FLAG_SECURE : 0));
+	if (!request.h)
+		return _PGS_winhttp_error(method, url, error);
+
+	if (!auth.empty())
+		headers += _PGS_widen(auth) + L"\r\n";
+	if (body)
+		headers += L"Content-Type: application/json\r\n";
+
+	if (!WinHttpSendRequest(request.h, headers.c_str(), (DWORD) -1L,
+							body ? (LPVOID) body : WINHTTP_NO_REQUEST_DATA,
+							body_len, body_len, 0) ||
+		!WinHttpReceiveResponse(request.h, nullptr) ||
+		!WinHttpQueryHeaders(request.h,
+							 WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+							 WINHTTP_HEADER_NAME_BY_INDEX, &status, &size,
+							 WINHTTP_NO_HEADER_INDEX))
+		return _PGS_winhttp_error(method, url, error);
+
+	for (;;)
+	{
+		DWORD		avail = 0;
+		DWORD		got = 0;
+		char		buf[8192];
+
+		if (!WinHttpQueryDataAvailable(request.h, &avail))
+			return _PGS_winhttp_error(method, url, error);
+		if (avail == 0)
+			break;
+		if (avail > sizeof(buf))
+			avail = sizeof(buf);
+		if (!WinHttpReadData(request.h, buf, avail, &got))
+			return _PGS_winhttp_error(method, url, error);
+		if (got == 0)
+			break;
+		if (response.size() + got > MAX_RESPONSE)
+		{
+			error = "AM's answer is too large";
+			return -1;
+		}
+		response.append(buf, got);
+	}
+	return (int) status;
+}
+#else
+int
+_PGS_http(const std::string &, const std::string &, const std::string &,
+	 const char *, int, std::string &, std::string &error)
+{
+	error = "the AM client is only built for Windows (WinHTTP)";
+	return -1;
+}
+#endif
+
+/*
+ * The text of a string field in a JSON answer ("accessToken": "..."), or
+ * empty.  AM's answers are small and well formed; this is not a general
+ * JSON parser.
+ */
+std::string
+_PGS_json_text(const std::string &json, const std::string &field)
+{
+	size_t		at = json.find("\"" + field + "\"");
+	std::string out;
+
+	if (at == std::string::npos)
+		return out;
+	at = json.find(':', at + field.size() + 2);
+	if (at == std::string::npos)
+		return out;
+	at = json.find_first_not_of(" \t\r\n", at + 1);
+	if (at == std::string::npos || json[at] != '"')
+		return out;
+	for (size_t i = at + 1; i < json.size(); i++)
+	{
+		if (json[i] == '"')
+			return out;
+		if (json[i] == '\\')
+			return std::string();	/* escapes never occur in a token */
+		out += json[i];
+	}
+	return std::string();
+}
+
+/*
+ * One call to AM's admin API: sign in as the platform admin, make the call
+ * with the token, sign out.  Returns the call's HTTP status, or the sign-in's
+ * if that failed (answer then holds AM's reason), or -1.
+ */
+int
+_PGS_admin_http(const Config &cfg, const std::string &url,
+				const std::string &method, const std::string &path,
+				const char *body, int timeout_ms,
+				std::string &answer, std::string &error)
+{
+	std::string login = "{\"username\": " + _PGS_json_string(_PGS_setting(cfg, "admin_user", "")) +
+		", \"password\": " + _PGS_json_string(_PGS_setting(cfg, "admin_password", "")) + "}";
+	std::string token;
+	std::string ignored;
+	std::string ignored_error;
+	int			status;
+
+	status = _PGS_http("POST", url + _PGS_setting(cfg, "path.admin_token", "/api/admin/auth/token"),
+					   "", login.c_str(), timeout_ms, answer, error);
+	if (status != 200)
+		return status;
+	token = _PGS_json_text(answer, "accessToken");
+	answer.clear();
+	if (token.empty())
+	{
+		error = "AM's sign-in answer has no accessToken";
+		return -1;
+	}
+
+	status = _PGS_http(method, url + path, "Authorization: Bearer " + token,
+					   body, timeout_ms, answer, error);
+
+	/* the token would expire on its own; ending it now is tidier */
+	_PGS_http("POST", url + _PGS_setting(cfg, "path.admin_logout", "/api/admin/auth/logout"),
+			  "Authorization: Bearer " + token, nullptr, timeout_ms, ignored, ignored_error);
+	return status;
+}
+
+/* body (a JSON object) with one more field: "name": value (value is JSON) */
+std::string
+_PGS_with_field(const char *body, const std::string &name, const std::string &value)
+{
+	std::string out = body ? body : "{}";
+	size_t		end = out.find_last_of('}');
+
+	if (end == std::string::npos)
+		return out;
+	return out.substr(0, end) + ", " + _PGS_json_string(name) + ": " + value + "}";
+}
+
+/*
+ * A new tenant for AM's admin API: PostgreSQL's {"slug", "name"} plus the
+ * tenant's first admin from am_client.conf, which AM requires.
+ */
+std::string
+_PGS_with_tenant_admin(const Config &cfg, const char *body)
+{
+	return _PGS_with_field(body, "admin",
+						   "{\"username\": " + _PGS_json_string(_PGS_setting(cfg, "tenant_admin_user", "")) +
+						   ", \"password\": " + _PGS_json_string(_PGS_setting(cfg, "tenant_admin_password", "")) + "}");
+}
+
+/*
+ * 32 random letters and digits.  std::random_device is the operating
+ * system's secure generator on Windows (rand_s).
+ */
+std::string
+_PGS_random_password()
+{
+	static const char chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
+	std::random_device rd;
+	std::string out;
+
+	while (out.size() < 32)
+	{
+		unsigned int r = rd() & 63;
+
+		if (r < 62)				/* no modulo bias */
+			out += chars[r];
+	}
+	return out;
+}
+
+}								/* namespace */
+
+extern "C" int
+_PGS_AmClient_Call(const char *endpoint, const char *username, long long tenant_id,
+			  const char *body, char **response, char *errbuf, int errbuflen)
+{
+	if (response)
+		*response = nullptr;
+	if (errbuf && errbuflen > 0)
+		errbuf[0] = '\0';
+
+	try
+	{
+		Config		cfg = _PGS_read_config();
+		std::string ep = endpoint ? endpoint : "";
+		std::string method = ep == "user_assets" ? "GET" : "POST";
+		std::string path;
+		std::string url = _PGS_setting(cfg, "url", "");
+		std::string api_key;
+		std::string answer;
+		std::string error;
+		int			timeout_ms = atoi(_PGS_setting(cfg, "timeout_ms", "5000").c_str());
+		int			status;
+
+		/* the matrix and new tenants go to AM's admin API when one is set */
+		bool		admin = (ep == "tenants" || ep == "roles") &&
+			!_PGS_setting(cfg, "admin_user", "").empty();
+
+		if (ep == "tenants")
+			path = _PGS_setting(cfg, "path.tenants",
+								admin ? "/api/admin/tenants" : "/api/v1/tenants");
+		else if (ep == "users")
+			path = _PGS_setting(cfg, "path.users", "/api/v1/users");
+		else if (ep == "roles")
+			path = _PGS_setting(cfg, "path.roles",
+								admin ? "/api/admin/role-asset-map" : "/api/v1/roles");
+		else if (ep == "user_assets")
+		{
+			size_t		at;
+
+			std::string user = username ? username : "";
+
+			/*
+			 * url_encode leaves dots alone and URL parsing collapses "." and
+			 * "..", so a user named ".." would turn /users/../assets into
+			 * /assets: another endpoint.
+			 */
+			if (user.empty() || user == "." || user == "..")
+			{
+				snprintf(errbuf, errbuflen, "\"%s\" is not a valid username for AM", user.c_str());
+				return -1;
+			}
+			path = _PGS_setting(cfg, "path.user_assets", "/api/v1/users/{username}/assets");
+			at = path.find("{username}");
+			if (at != std::string::npos)
+				path.replace(at, 10, _PGS_url_encode(user));
+			body = nullptr;
+		}
+		else
+		{
+			snprintf(errbuf, errbuflen, "unknown AM endpoint \"%s\"", ep.c_str());
+			return -1;
+		}
+
+		if (url.empty())
+		{
+			_PGS_write_outbox(method, path, tenant_id, 0, body);
+			return 0;
+		}
+		while (!url.empty() && url.back() == '/')
+			url.pop_back();
+
+		if (admin)
+		{
+			std::string sent = ep == "tenants" ? _PGS_with_tenant_admin(cfg, body) : body ? body : "";
+
+			status = _PGS_admin_http(cfg, url, method, path, sent.c_str(), timeout_ms,
+									 answer, error);
+		}
+		else
+		{
+			std::string sent = body ? body : "";
+
+			if (ep == "users" && _PGS_setting(cfg, "user_password", "") == "random")
+				sent = _PGS_with_field(body, "password", _PGS_json_string(_PGS_random_password()));
+			api_key = _PGS_setting(cfg, "api_key." + std::to_string(tenant_id),
+							  _PGS_setting(cfg, "api_key", ""));
+			status = _PGS_http(method, url + path,
+						  api_key.empty() ? "" : "X-Api-Key: " + api_key,
+						  body ? sent.c_str() : nullptr,
+						  timeout_ms, answer, error);
+		}
+		/* PostgreSQL's body only: never a password */
+		_PGS_write_outbox(method, path, tenant_id, status, body);
+
+		if (status < 0)
+		{
+			snprintf(errbuf, errbuflen, "%s", error.c_str());
+			return -1;
+		}
+		if (response)
+		{
+			*response = (char *) malloc(answer.size() + 1);
+			if (*response)
+				memcpy(*response, answer.c_str(), answer.size() + 1);
+		}
+		return status;
+	}
+	catch (...)
+	{
+		if (errbuf && errbuflen > 0)
+			snprintf(errbuf, errbuflen, "internal error in the AM client");
+		return -1;
+	}
+}
+
+extern "C" void
+_PGS_AmClient_Free(char *response)
+{
+	free(response);
+}
