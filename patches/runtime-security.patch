+
+/* ----------------------------------------------------------------
+ *	   Runtime security: catch the rows of the Secure-ERMS tenant,
+ *	   user account and role / protected-type tables
+ *
+ * ExecModifyTable() calls _PGS_RuntimeSecurity_CaptureRow() for each row it
+ * writes.  The tables are found by name, in any schema that also has a
+ * user_asset_map table (so other databases with tables of the same names,
+ * such as the Secure-ERMS test pack's, are left alone):
+ *
+ *	INSERT INTO tenants / user_accounts      the tenant / user (by id)
+ *	UPDATE tenants that sets status          a disabled tenant
+ *	UPDATE user_accounts that sets login_status or status
+ *	                                         login (1), logout (0), disabled
+ *	any write to roles, protected_type_catalog,
+ *	  role_protected_type_permissions        the matrix changed
+ *
+ * Only the row's id is kept here; standard_ExecutorFinish() (execMain.c)
+ * handles the rows when the statement ends.
+ * ----------------------------------------------------------------
+ */
+static bool
+_PGS_rsc_is_matrix_table(const char *relname)
+{
+	return strcmp(relname, "role_protected_type_permissions") == 0 ||
+		strcmp(relname, "roles") == 0 ||
+		strcmp(relname, "protected_type_catalog") == 0;
+}
+
+/* Only schemas set up for runtime security: they have user_asset_map */
+static bool
+_PGS_rsc_schema_enabled(Relation rel)
+{
+	return OidIsValid(get_relname_relid("user_asset_map",
+										RelationGetNamespace(rel)));
+}
+
+/* Does this UPDATE set the column? */
+static bool
+_PGS_rsc_sets_column(Relation rel, ResultRelInfo *resultRelInfo,
+					 EState *estate, const char *column)
+{
+	AttrNumber	attnum = attnameAttNum(rel, column, false);
+
+	return attnum > 0 &&
+		bms_is_member(attnum - FirstLowInvalidHeapAttributeNumber,
+					  ExecGetUpdatedCols(resultRelInfo, estate));
+}
+
+/* The bigint id column of a captured row, or false if it has none */
+static bool
+_PGS_rsc_row_id(Relation rel, TupleTableSlot *slot, const char *column, int64 *id)
+{
+	AttrNumber	attnum = attnameAttNum(rel, column, false);
+	Datum		value;
+	bool		isnull;
+
+	if (attnum <= 0 || slot == NULL || TupIsNull(slot))
+		return false;
+	value = slot_getattr(slot, attnum, &isnull);
+	if (isnull)
+		return false;
+
+	switch (TupleDescAttr(RelationGetDescr(rel), attnum - 1)->atttypid)
+	{
+		case INT8OID:
+			*id = DatumGetInt64(value);
+			return true;
+		case INT4OID:
+			*id = DatumGetInt32(value);
+			return true;
+		default:
+			return false;
+	}
+}
+
+/*
+ * One row written by ExecModifyTable (slot is the new row; NULL for DELETE
+ * and MERGE).  Rows of any other table return after a name compare.
+ */
+static void
+_PGS_RuntimeSecurity_CaptureRow(ModifyTableState *mtstate,
+						   ResultRelInfo *resultRelInfo,
+						   CmdType operation,
+						   TupleTableSlot *slot)
+{
+	Relation	rel = resultRelInfo->ri_RelationDesc;
+	EState	   *estate = mtstate->ps.state;
+	const char *relname = RelationGetRelationName(rel);
+	int64		id = 0;
+	RscEventKind kind;
+
+	if (!IsNormalProcessingMode())
+		return;
+
+	if (_PGS_rsc_is_matrix_table(relname))
+		kind = RSC_MATRIX_CHANGED;
+	else if (strcmp(relname, "tenants") == 0 && operation == CMD_INSERT)
+	{
+		if (!_PGS_rsc_row_id(rel, slot, "tenant_id", &id))
+			return;
+		kind = RSC_TENANT_CREATED;
+	}
+	else if (strcmp(relname, "tenants") == 0 && operation == CMD_UPDATE)
+	{
+		if (!_PGS_rsc_sets_column(rel, resultRelInfo, estate, "status") ||
+			!_PGS_rsc_row_id(rel, slot, "tenant_id", &id))
+			return;
+		kind = RSC_TENANT_STATUS;
+	}
+	else if (strcmp(relname, "user_accounts") == 0 && operation == CMD_INSERT)
+	{
+		if (!_PGS_rsc_row_id(rel, slot, "user_id", &id))
+			return;
+		kind = RSC_USER_CREATED;
+	}
+	else if (strcmp(relname, "user_accounts") == 0 && operation == CMD_UPDATE)
+	{
+		/* Login / logout (login_status) or the account state (status) */
+		if (!_PGS_rsc_sets_column(rel, resultRelInfo, estate, "login_status") &&
+			!_PGS_rsc_sets_column(rel, resultRelInfo, estate, "status"))
+			return;
+		if (!_PGS_rsc_row_id(rel, slot, "user_id", &id))
+			return;
+		kind = RSC_USER_STATUS;
+	}
+	else
+		return;
+
+	if (!_PGS_rsc_schema_enabled(rel))
+		return;
+
+	_PGS_RuntimeSecurity_AddEvent(kind, estate, rel, id);
+}
+
